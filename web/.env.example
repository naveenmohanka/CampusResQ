# Firebase Web Configuration for CampusResQ Admin Dashboard
# Note: Web and Android use the SAME Firebase project, but SEPARATE client configs.
# Get these Web values from: Firebase Console -> Project Settings -> General -> Your Apps -> Web App

VITE_FIREBASE_API_KEY=AIzaSyExampleKey123456789
VITE_FIREBASE_AUTH_DOMAIN=campusresq-29f13.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=campusresq-29f13
VITE_FIREBASE_STORAGE_BUCKET=campusresq-29f13.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=450575997759
VITE_FIREBASE_APP_ID=1:450575997759:web:examplewebapp123

# Mode Configuration (Default: false)
# When false: uses real production Firestore/Auth/Storage if configured
# When true: forces simulated offline campus demonstration data
VITE_DEMO_MODE=false
