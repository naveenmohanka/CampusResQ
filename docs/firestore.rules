rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to get user profile document data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper function to check if authenticated user is an administrator
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    // Helper function to check if authenticated user is a mentor
    function isMentor() {
      return isAuthenticated() && getUserData().role == 'mentor';
    }

    // ===============================================================
    // Users Collection Security Rules
    // ===============================================================
    match /users/{userId} {
      // Any authenticated user can read their own profile; Admins can read all profiles
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // Users can create their own profile during initial signup
      allow create: if isAuthenticated() && request.auth.uid == userId;
      
      // Users can update their personal details (phone, department); only Admins can change roles
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) ||
        isAdmin()
      );
      
      // Only Admins can delete users
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Incidents Collection Security Rules
    // ===============================================================
    match /incidents/{incidentId} {
      // Authenticated users can read incidents (Students see theirs, Admins/Mentors see all)
      allow read: if isAuthenticated();
      
      // Any authenticated user can report a new incident
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      
      // Admins have full update rights; Mentors can update incidents assigned to them
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (isMentor() && resource.data.assignedTo == request.auth.uid)
      );
      
      // Only Admins can delete incidents
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Activity Logs Collection Security Rules
    // ===============================================================
    match /activityLogs/{logId} {
      // Authenticated users can view activity logs
      allow read: if isAuthenticated();
      
      // System & authenticated operations can write audit log entries
      allow create: if isAuthenticated();
      
      // Logs are immutable: no modifications or deletions allowed
      allow update, delete: if false;
    }
  }
}
